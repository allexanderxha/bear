// features.vr — tests for newly added language features.
//   vr run examples/features.vr
//   vr test examples/features.vr

fn test_negative_index_array() {
	let a = [10, 20, 30, 40]
	assert a[-1] == 40
	assert a[-2] == 30
	assert a[-4] == 10
	// assignment with negative index
	mut b = [1, 2, 3]
	b[-1] = 99
	assert b[2] == 99
	b[-3] = 7
	assert b[0] == 7
}

fn test_negative_index_string() {
	let s = "hello"
	assert s[-1] == "o"
	assert s[-5] == "h"
}

fn test_negative_index_out_of_bounds() {
	// a[-4] on a 3-element array: -4 + 3 = -1, still < 0, so it errors.
	// (Array out-of-bounds is a VM-level error, not a catchable throw.)
	// We just confirm the valid negative range works:
	let a = [1, 2, 3]
	assert a[-1] == 3
	assert a[-3] == 1
}

fn test_match_ranges() {
	mut result = ""
	match 5 {
		1..3 {
			result = "low"
		}
		4..6 {
			result = "mid"
		}
		7..10 {
			result = "high"
		}
		else {
			result = "other"
		}
	}
	assert result == "mid"

	match 2 {
		1..3 {
			result = "low"
		}
		else {
			result = "other"
		}
	}
	assert result == "low"

	match 99 {
		1..10 {
			result = "range"
		}
		else {
			result = "else"
		}
	}
	assert result == "else"
}

fn test_match_range_before_exact() {
	// exact arm before a range arm that would also match
	mut r = ""
	match 7 {
		7 {
			r = "exact"
		}
		1..10 {
			r = "range"
		}
	}
	assert r == "exact"
}

fn test_int_overflow_promotes_to_float() {
	// 1 << 60 is the int boundary; larger values promote to float
	let big = 1 << 60
	assert big == big  // identity; it's a valid value (promoted to float)
	// float promotion: large ints keep working as floats
	let x = 1 << 62
	assert x > 0
	assert x == x
}

fn test_string_const() {
	// covered in constants.vr, but assert here too
	assert "ok"
}

fn main() {
	println("running feature tests...")
	// negative index on arrays
	let a = [10, 20, 30]
	println(a[-1])
	println(a[-2])
	// match ranges
	match 5 {
		1..3 { println("low") }
		4..6 { println("mid") }
		else { println("other") }
	}
	println("done")
}
